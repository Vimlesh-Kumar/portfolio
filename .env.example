# Contact form (Web3Forms) — copy this file to `.env` and fill in your key.
#
# Get a FREE access key at https://web3forms.com — no signup or billing, you
# just enter the email address where you want messages delivered and they email
# you a key. The key is public by design (client-side), so it's safe to expose.
VITE_WEB3FORMS_ACCESS_KEY=
